{
  "name": "@pxweb2/source",
  "version": "2.14.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --fix",
    "prettier": "npm run prettier --workspaces",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tests --workspaces",
    "test": "npm run test --workspaces",
    "coverage": "npm run coverage --workspaces",
    "build": "npm run build-style-dictionary && npm run build --workspaces",
    "build-artifact": "npm run build-style-dictionary && cd ./packages/pxweb2 && npm run build",
    "build-storybook": "npm run build-storybook --workspace=@pxweb2/pxweb2-ui",
    "build-i18n-interface": "npx i18next-resources-for-ts interface -i ./packages/pxweb2/public/locales/en -o ./packages/pxweb2/src/@types/resources.d.ts",
    "build-style-dictionary": "cd ./packages/pxweb2-ui && npm run build-style-dictionary",
    "build-api-client": "npx openapi-typescript-codegen --input https://raw.githubusercontent.com/PxTools/PxApiSpecs/master/PxAPI-2.yml --output ./packages/pxweb2-api-client/src --request ./packages/pxweb2-api-client/custom/request.ts"
  },
  "private": true,
  "dependencies": {
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react": "^6.2.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.20",
    "sass": "^1.107.1",
    "uuid": "^14.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "jsdom": "^30.1.3",
    "style-dictionary": "^5.7.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-dts": "^1.1.2",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "readme": "ERROR: No README data found!",
  "_id": "@pxweb2/source@0.0.0",
  "workspaces": [
    "packages/*"
  ]
}
