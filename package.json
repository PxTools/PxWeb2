{
  "name": "@pxweb2/source",
  "version": "2.14.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --fix",
    "prettier": "pnpm -r prettier",
    "typecheck": "pnpm -r typecheck && pnpm -r typecheck:tests",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "build": "pnpm build-style-dictionary && pnpm -r --no-sort --workspace-concurrency=1 build",
    "build-artifact": "pnpm build-style-dictionary && pnpm --filter pxweb2 build",
    "build-storybook": "pnpm --filter @pxweb2/pxweb2-ui build-storybook",
    "build-i18n-interface": "pnpm dlx i18next-resources-for-ts interface -i ./packages/pxweb2/public/locales/en -o ./packages/pxweb2/src/@types/resources.d.ts",
    "build-style-dictionary": "pnpm --filter @pxweb2/pxweb2-ui build-style-dictionary",
    "build-api-client": "pnpm dlx openapi-typescript-codegen --input https://raw.githubusercontent.com/PxTools/PxApiSpecs/master/PxAPI-2.yml --output ./packages/pxweb2-api-client/src --request ./packages/pxweb2-api-client/custom/request.ts"
  },
  "private": true,
  "dependencies": {
    "@pxweb2/pxweb2-ui": "workspace:^",
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react": "^6.2.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.20",
    "sass": "^1.107.1",
    "uuid": "^14.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "style-dictionary": "^5.7.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-dts": "^1.1.2",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "readme": "ERROR: No README data found!",
  "_id": "@pxweb2/source@0.0.0"
}
