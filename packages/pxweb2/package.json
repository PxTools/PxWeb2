{
  "name": "pxweb2",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "author": "",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:html-validate": "pnpm build && concurrently --kill-others-on-fail \"vite preview\" \"node test/html-validator.js\"",
    "prettier": "prettier --config ../../.prettierrc --check ./src/** --write --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@pxweb2/pxweb2-api-client": "workspace:^",
    "@pxweb2/pxweb2-ui": "workspace:^",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "motion": "^14.9.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "ajv": "^8.18.0",
    "concurrently": "^10.0.6",
    "html-validate": "^11.18.0",
    "playwright": "^1.64.1",
    "vite-plugin-babel": "^1.7.3",
    "vitest": "^5.0.1"
  }
}
