{
  "name": "@pxweb2/pxweb2-ui",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "start": "npm run storybook",
    "build": "npm run build-style-dictionary && storybook build && mv ./storybook-static ../pxweb2/dist/storybook",
    "build-style-dictionary": "node ./style-dictionary/build.mjs",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.storybook.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prettier": "prettier --config ../../.prettierrc --check ./src/** --write --ignore-path ../../.prettierignore"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.11",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "motion": "^13.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "^16.3.3",
    "eslint-plugin-storybook": "10.6.0",
    "prop-types": "^15.8.1",
    "shiki": "^4.4.3",
    "storybook": "10.6.0",
    "vitest": "^4.0.18"
  }
}
